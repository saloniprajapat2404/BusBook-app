// use prisma-8
enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model User {
  id            String                     @id @default(uuid())
  email         String                     @unique
  emailVerified Boolean                    @default(false)
  name          String?
  image         String?
  createdAt     TimestamptzString          @default(now())
  updatedAt     temporal.updatedAtString()

  // Better Auth Relations
  sessions      Session[]
  accounts      Account[]

  // App Relations
  bookings      Booking[]
}

model Session {
  id        String                     @id @default(uuid())
  userId    String
  user      User                       @relation(fields:[userId], references:[id])
  token     String                     @unique
  expiresAt TimestamptzString
  ipAddress String?
  userAgent String?
  createdAt TimestamptzString          @default(now())
  updatedAt temporal.updatedAtString()
}

model Account {
  id                    String                     @id @default(uuid())
  userId                String
  user                  User                       @relation(fields:[userId], references:[id])
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  TimestamptzString?
  refreshTokenExpiresAt TimestamptzString?
  scope                 String?
  idToken               String?
  password              String?
  createdAt             TimestamptzString          @default(now())
  updatedAt             temporal.updatedAtString()
}

model Verification {
  id         String                     @id @default(uuid())
  identifier String
  value      String
  expiresAt  TimestamptzString
  createdAt  TimestamptzString          @default(now())
  updatedAt  temporal.updatedAtString()
}

model Route {
  id          String                     @id @default(uuid())
  source      String
  destination String
  distanceKm  Float?
  durationHrs Float?
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()

  buses       Bus[]
}

model Bus {
  id         String                     @id @default(uuid())
  busNumber  String                     @unique
  operator   String?
  totalSeats Int                        @default(40)
  busType    String?
  routeId    String
  route      Route                      @relation(fields:[routeId], references:[id])
  seats      Seat[]
  createdAt  TimestamptzString          @default(now())
  updatedAt  temporal.updatedAtString()
}

model Seat {
  id         String                     @id @default(uuid())
  seatNumber String
  isBooked   Boolean                    @default(false)
  busId      String
  bus        Bus                        @relation(fields:[busId], references:[id])
  bookings   Booking[]
  createdAt  TimestamptzString          @default(now())
  updatedAt  temporal.updatedAtString()

  @@unique([busId, seatNumber])
}

model Booking {
  id          String                     @id @default(uuid())
  bookingDate TimestamptzString          @default(now())
  status      BookingStatus              @default(PENDING)
  totalAmount Float?
  userId      String
  user        User                       @relation(fields:[userId], references:[id])
  seatId      String
  seat        Seat                       @relation(fields:[seatId], references:[id])
  createdAt   TimestamptzString          @default(now())
  updatedAt   temporal.updatedAtString()
}
